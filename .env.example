# Both optional. With neither set, the app runs on the bundled mock adapter and
# nothing else changes: same components, same three data functions.
#
# Set both to read the real `buildings` table. The anon key belongs in the
# browser here because the table's RLS policy grants SELECT and nothing else.
# Never put a service-role key in a NEXT_PUBLIC_ variable.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional. Only used to build absolute URLs for social card metadata.
# Netlify sets URL automatically, so this is rarely needed.
# NEXT_PUBLIC_SITE_URL=
